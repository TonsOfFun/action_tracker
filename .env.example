# Copy to .env (git-ignored) and fill in.
ANTHROPIC_API_KEY=
# Optional: a second provider, to compare models in an evaluation.
OPENAI_API_KEY=
# Optional: the Anthropic model new runs default to.
# TRACKER_MODEL=claude-haiku-4-5

# Optional, for the pull request part of the demo: a GitHub OAuth app
# (github.com/settings/developers) whose callback URL is
# http://localhost:3000/activeagents/api/github_connection/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: send traces to a hosted workspace on activeagents.ai instead of
# this app's own database. Create the key under Settings -> API Keys there.
ACTIVEAGENTS_API_KEY=
